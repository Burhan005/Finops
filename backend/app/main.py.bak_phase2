@app.post("/api/anomalies/{alert_id}/acknowledge")
def acknowledge_anomaly(alert_id: int, req: AnomalyActionRequest, db: Session = Depends(get_db)):
    alert = db.query(AnomalyAlert).filter(AnomalyAlert.id == alert_id).first()
    if not alert:
        raise HTTPException(status_code=404, detail="Anomaly alert not found")
    alert.status = "ACKNOWLEDGED"
    alert.acknowledged_by = req.user_name or "Admin"
    alert.acknowledged_at = datetime.utcnow()
    if req.notes:
        alert.notes = (alert.notes + "\n" + req.notes) if alert.notes else req.notes
    db.commit()
    db.refresh(alert)
    return {"success": True, "alert_id": alert.id, "status": alert.status}

@app.post("/api/anomalies/{alert_id}/resolve")
def resolve_anomaly(alert_id: int, req: AnomalyActionRequest, db: Session = Depends(get_db)):
    alert = db.query(AnomalyAlert).filter(AnomalyAlert.id == alert_id).first()
    if not alert:
        raise HTTPException(status_code=404, detail="Anomaly alert not found")
    alert.status = "RESOLVED"
    alert.resolved_by = req.user_name or "Admin"
    alert.resolved_at = datetime.utcnow()
    if req.notes:
        alert.notes = (alert.notes + "\n" + req.notes) if alert.notes else req.notes
    db.commit()
    db.refresh(alert)
    return {"success": True, "alert_id": alert.id, "status": alert.status}


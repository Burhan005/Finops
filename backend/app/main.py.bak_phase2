    try:
        sync_recommendations_to_ledger(db, raw.get('recommendations', []))
    except Exception as e:
        print(f"Ledger sync warning: {e}")
    return raw

@app.get("/api/resources")
def search_resources(
    query: Optional[str] = None,
    service: Optional[str] = None,
    account_id: Optional[str] = None,
    min_cost: Optional[float] = None,
    limit: int = 100
):
    if not CURRENT_DATASET.get('data'):
        raise HTTPException(status_code=400, detail="No active dataset loaded")

    resources = CURRENT_DATASET['data'].get('resources', [])
    filtered = resources

    if account_id and account_id != "all":
        filtered = [r for r in filtered if r.get('account_id') == account_id]

    if query:
        q = query.lower()
        filtered = [
            r for r in filtered
            if q in r['resource_id'].lower() or q in r['name'].lower() or any(q in ut.lower() for ut in r['usage_types'])
        ]

    if service and service != "All":
        filtered = [r for r in filtered if r['service'] == service]

    if min_cost is not None:
        filtered = [r for r in filtered if r['total_cost'] >= min_cost]

    return {
        "total_matches": len(filtered),
        "resources": filtered[:limit]
    }


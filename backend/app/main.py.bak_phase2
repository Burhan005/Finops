@app.get("/api/ai/history")
def get_ai_history(limit: int = 20, db: Session = Depends(get_db)):
    rows = db.query(AiAnalystQuery).order_by(AiAnalystQuery.id.desc()).limit(limit).all()
    return [{
        "id": r.id,
        "query": r.query_text,
        "intent": r.intent_detected,
        "answer": r.response_text,
        "provider_used": r.provider_used,
        "timestamp": r.created_at.isoformat()
    } for r in rows]

# Mount static frontend assets if built
if os.path.exists(FRONTEND_DIST):
    assets_dir = os.path.join(FRONTEND_DIST, 'assets')
    if os.path.exists(assets_dir):
        app.mount("/assets", StaticFiles(directory=assets_dir), name="assets")

    @app.get("/{full_path:path}")
    def serve_spa(full_path: str):
        file_path = os.path.join(FRONTEND_DIST, full_path)
        if full_path and os.path.exists(file_path):
            return FileResponse(file_path)
        return FileResponse(os.path.join(FRONTEND_DIST, "index.html"))


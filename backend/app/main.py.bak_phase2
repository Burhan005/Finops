@app.post("/api/budgets")
def create_budget(req: BudgetCreateRequest, db: Session = Depends(get_db)):
    new_b = BudgetConfig(
        name=req.name.strip(),
        scope_type=req.scope_type,
        scope_value=req.scope_value,
        monthly_budget_usd=max(1.0, req.monthly_budget_usd),
        alert_threshold_pct=req.alert_threshold_pct,
        notification_email=req.notification_email,
        is_active=1
    )
    db.add(new_b)
    db.commit()
    db.refresh(new_b)
    if CURRENT_DATASET.get('data'):
        return evaluate_budgets(db, CURRENT_DATASET['data'])
    return [{"id": new_b.id, "name": new_b.name, "status": "HEALTHY"}]

@app.delete("/api/budgets/{budget_id}")
def delete_budget(budget_id: int, db: Session = Depends(get_db)):
    db.query(BudgetConfig).filter(BudgetConfig.id == budget_id).delete()
    db.commit()
    return {"success": True, "deleted_id": budget_id}


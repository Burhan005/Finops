    account_id: Optional[str] = None

class MonthlyCompareRequest(BaseModel):
    baseline_month: str
    target_month: str
    account_id: Optional[str] = None

class S3SyncConfigRequest(BaseModel):
    bucket_name: str
    region: Optional[str] = "us-east-1"
    prefix: Optional[str] = ""
    role_arn: Optional[str] = ""

class RegisterRequest(BaseModel):
    name: str
    company: str

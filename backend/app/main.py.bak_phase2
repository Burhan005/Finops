# ==================== AUTHENTICATION API ====================

@app.post("/api/auth/register")
def register_user(req: RegisterRequest, db: Session = Depends(get_db)):
    clean_email = req.email.strip().lower()
    if not clean_email or not req.password:
        raise HTTPException(status_code=400, detail="Email and password are required")
    
    existing = db.query(User).filter(User.email == clean_email).first()
    if existing:
        raise HTTPException(status_code=400, detail="An account with this email already exists")

    pwd_hash = hash_password(req.password)
    user = User(
        name=req.name.strip() or "Cloud Engineer",
        company=req.company.strip() or "Enterprise",
        email=clean_email,
        password_hash=pwd_hash
    )
    db.add(user)
    db.commit()
    db.refresh(user)

    token = generate_session_token()
    session = UserSession(token=token, user_id=user.id)
    db.add(session)
    db.commit()

    return {
        "token": token,
        "user": {
            "id": user.id,
            "name": user.name,
            "company": user.company,
            "email": user.email
        }
    }

@app.post("/api/auth/login")
def login_user(req: LoginRequest, db: Session = Depends(get_db)):
    clean_email = req.email.strip().lower()
    if not clean_email or not req.password:
        raise HTTPException(status_code=400, detail="Email and password are required")

    user = db.query(User).filter(User.email == clean_email).first()
    if not user:
        raise HTTPException(status_code=401, detail="Invalid email or password")

    is_valid, needs_upgrade = verify_and_upgrade_password(req.password, user.password_hash)
    if not is_valid:
        raise HTTPException(status_code=401, detail="Invalid email or password")

    # Transparent zero-downtime hash upgrade from legacy sha256 to modern bcrypt
    if needs_upgrade:
        user.password_hash = hash_password(req.password)
        db.commit()

    token = generate_session_token()
    session = UserSession(token=token, user_id=user.id)
    db.add(session)
    db.commit()

    return {
        "token": token,
        "user": {
            "id": user.id,
            "name": user.name,
            "company": user.company,
            "email": user.email
        }
    }

@app.get("/api/auth/me")
def get_current_user(token: Optional[str] = None, db: Session = Depends(get_db)):
    if token:
        sess = db.query(UserSession).filter(UserSession.token == token).first()
        if sess:
            user = db.query(User).filter(User.id == sess.user_id).first()
            if user:
                return {
                    "user": {
                        "id": user.id,
                        "name": user.name,
                        "company": user.company,
                        "email": user.email
                    }
                }

    return {"user": None}

@app.post("/api/auth/logout")
def logout_user(token: Optional[str] = None, db: Session = Depends(get_db)):
    if token:
        db.query(UserSession).filter(UserSession.token == token).delete()
        db.commit()
    return {"success": True}

@app.post("/api/auth/forgot-password")
def forgot_password(req: ForgotPasswordRequest, db: Session = Depends(get_db)):
    clean_email = req.email.strip().lower()
    if not clean_email:
        raise HTTPException(status_code=400, detail="Email is required")
    user = db.query(User).filter(User.email == clean_email).first()
    if not user:
        raise HTTPException(status_code=404, detail="No registered workspace found with this email")
    reset_token = secrets.token_hex(16)
    return {
        "success": True,
        "message": f"Password reset instructions and verification token generated for {clean_email}.",
        "reset_token": reset_token
    }

@app.post("/api/auth/reset-password")
def reset_password(req: ResetPasswordRequest, db: Session = Depends(get_db)):
    clean_email = req.email.strip().lower()
    if not clean_email or not req.password:
        raise HTTPException(status_code=400, detail="Email and new password are required")
    if len(req.password) < 6:
        raise HTTPException(status_code=400, detail="Password must be at least 6 characters")
    user = db.query(User).filter(User.email == clean_email).first()
    if not user:
        raise HTTPException(status_code=404, detail="Workspace account not found")
    user.password_hash = hashlib.sha256(req.password.encode()).hexdigest()
    db.commit()
    return {
        "success": True,
        "message": "Password successfully updated. You can now sign in."
    }




@app.get("/api/datasets")
def list_datasets(db: Session = Depends(get_db)):
    samples = []
    for fp in glob.glob(os.path.join(SAMPLES_DIR, '*.*')):
        if fp.endswith(('.csv', '.gz')):
            size_kb = round(os.path.getsize(fp) / 1024, 1)
            samples.append({
                "filename": os.path.basename(fp),
                "type": "sample",
                "size_kb": size_kb,
                "is_active": (os.path.basename(fp) == CURRENT_DATASET.get('filename'))
            })

    uploads = []
    for fp in glob.glob(os.path.join(UPLOADS_DIR, '*.*')):
        if fp.endswith(('.csv', '.gz')):
            size_kb = round(os.path.getsize(fp) / 1024, 1)
            uploads.append({
                "filename": os.path.basename(fp),
                "type": "upload",
                "size_kb": size_kb,
                "is_active": (os.path.basename(fp) == CURRENT_DATASET.get('filename'))
            })

    return {
        "active_dataset": CURRENT_DATASET.get('filename'),
        "samples": samples,
        "uploads": uploads
    }

@app.post("/api/datasets/select")
def select_dataset(req: SelectDatasetRequest):
    fname = req.filename
    target_path = os.path.join(SAMPLES_DIR, fname)
    if not os.path.exists(target_path):
        target_path = os.path.join(UPLOADS_DIR, fname)

    if not os.path.exists(target_path):
        raise HTTPException(status_code=404, detail=f"Dataset {fname} not found")

    try:
        parsed = parse_cur_file(target_path)
        CURRENT_DATASET['filename'] = fname
        CURRENT_DATASET['filepath'] = target_path
        CURRENT_DATASET['data'] = parsed
        return {
            "success": True,
            "filename": fname,
            "total_cost": parsed['total_cost'],
            "total_rows": parsed['total_rows'],
            "dates_count": len(parsed['dates'])
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error parsing file {fname}: {str(e)}")

@app.post("/api/upload")
async def upload_cur_file(file: UploadFile = File(...)):
    filename = file.filename
    if not (filename.endswith('.csv') or filename.endswith('.csv.gz') or filename.endswith('.gz')):
        raise HTTPException(status_code=400, detail="Only .csv and .csv.gz files are supported.")

    save_path = os.path.join(UPLOADS_DIR, filename)
    with open(save_path, "wb") as buffer:
        shutil.copyfileobj(file.file, buffer)

    try:
        parsed = parse_cur_file(save_path)
        CURRENT_DATASET['filename'] = filename
        CURRENT_DATASET['filepath'] = save_path
        CURRENT_DATASET['data'] = parsed
        return {
            "success": True,
            "filename": filename,
            "total_cost": parsed['total_cost'],
            "total_rows": parsed['total_rows'],
            "dates": parsed['dates'],
            "message": f"Successfully parsed and activated {filename}"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"File uploaded but failed to parse: {str(e)}")

@app.get("/api/overview")
def get_overview(
    start_date: Optional[str] = None, 
    end_date: Optional[str] = None,
    account_id: Optional[str] = None
):
    if not CURRENT_DATASET.get('data'):
        raise HTTPException(status_code=400, detail="No active dataset loaded")

    data = CURRENT_DATASET['data']
    recs = generate_recommendations(data)

    dates = data.get('dates', [])
    filtered_dates = dates
    if start_date:
        filtered_dates = [d for d in filtered_dates if d >= start_date]
    if end_date:
        filtered_dates = [d for d in filtered_dates if d <= end_date]

    daily_totals = data.get('daily_totals', {})
    if start_date or end_date:
        filtered_cost = round(sum(daily_totals.get(d, 0.0) for d in filtered_dates), 2)
    else:
        filtered_cost = data['total_cost']

    baseline_default = filtered_dates[-2] if len(filtered_dates) >= 2 else (filtered_dates[0] if filtered_dates else "")
    target_default = filtered_dates[-1] if filtered_dates else ""
    
    delta_info = None
    if baseline_default and target_default:
        delta_info = compare_dates(data, baseline_default, target_default, account_id=account_id)

    return {
        "filename": CURRENT_DATASET.get('filename'),
        "total_cost": filtered_cost,
        "total_rows": data['total_rows'],
        "dates": data['dates'],
        "filtered_dates": filtered_dates,
        "months": data['months'],
        "services": data['services'],
        "accounts": data.get('accounts', {}),
        "daily_totals": {d: daily_totals.get(d, 0.0) for d in filtered_dates},
        "default_comparison": {
            "baseline_date": baseline_default,
            "target_date": target_default,
            "delta_cost": delta_info['delta_cost'] if delta_info else 0.0,
            "pct_change": delta_info['pct_change'] if delta_info else 0.0,
            "pct_display": delta_info['pct_display'] if delta_info else "0.0%"
        },
        "potential_savings": recs['total_potential_savings'],
        "total_resources": len(data['resources'])
    }

@app.get("/api/trends")
def get_trends(start_date: Optional[str] = None, end_date: Optional[str] = None):
    if not CURRENT_DATASET.get('data'):
        raise HTTPException(status_code=400, detail="No active dataset loaded")
    return get_trend_data(CURRENT_DATASET['data'], start_date=start_date, end_date=end_date)

@app.post("/api/compare")
def compare_spending(req: CompareRequest):
    if not CURRENT_DATASET.get('data'):
        raise HTTPException(status_code=400, detail="No active dataset loaded")

    data = CURRENT_DATASET['data']
    dates = set(data.get('dates', []))

    if req.baseline_date not in dates:
        raise HTTPException(status_code=400, detail=f"Baseline date {req.baseline_date} not in dataset dates")
    if req.target_date not in dates:
        raise HTTPException(status_code=400, detail=f"Target date {req.target_date} not in dataset dates")

    return compare_dates(data, req.baseline_date, req.target_date, account_id=req.account_id)

@app.post("/api/analytics/daily-delta")
def get_daily_delta(req: DailyDeltaRequest):
    if not CURRENT_DATASET.get('data'):
        raise HTTPException(status_code=400, detail="No active dataset loaded")
    return calculate_daily_delta(CURRENT_DATASET['data'], req.target_date, req.baseline_date, account_id=req.account_id)

@app.post("/api/analytics/monthly-comparison")
def get_monthly_comparison(req: MonthlyCompareRequest):
